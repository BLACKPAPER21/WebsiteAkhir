{
    "buildCommand": "npm ci && npm run build && rm -rf dist && mkdir -p dist && cp -r public/. dist/ && rm -f dist/index.php dist/.htaccess",
    "outputDirectory": "dist",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.4",
            "memory": 1024,
            "maxDuration": 30,
            "regions": ["iad1"]
        }
    },
    "rewrites": [
        { "source": "/(.*)", "destination": "/api/index.php" }
    ]
}
