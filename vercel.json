{
    "version": 2,
    "regions": ["iad1"],
    "builds": [
        { "src": "api/index.php", "use": "vercel-php@0.7.4" },
        { "src": "public/**", "use": "@vercel/static" }
    ],
    "routes": [
        { "src": "/build/(.*)", "dest": "/public/build/$1" },
        { "src": "/(images|storage|css|js|fonts)/(.*)", "dest": "/public/$1/$2" },
        { "src": "/favicon.ico", "dest": "/public/favicon.ico" },
        { "src": "/robots.txt", "dest": "/public/robots.txt" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "LOG_CHANNEL": "stderr",
        "LOG_LEVEL": "error",
        "APP_STORAGE_PATH": "/tmp/demplane-storage",
        "VIEW_COMPILED_PATH": "/tmp/demplane-storage/framework/views",
        "SESSION_DRIVER": "database",
        "CACHE_STORE": "database",
        "QUEUE_CONNECTION": "database",
        "BROADCAST_CONNECTION": "log",
        "FILESYSTEM_DISK": "local",
        "MAIL_MAILER": "log"
    }
}
